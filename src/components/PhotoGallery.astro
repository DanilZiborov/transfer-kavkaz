---
import { getImage, Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { GalleryPhoto } from '../data/photography';

interface Props {
  photos: GalleryPhoto[];
  group: string;
  layout?: 'travel' | 'vehicle';
}

const { photos: sourcePhotos, group, layout = 'travel' } = Astro.props;
const imageSizes = layout === 'vehicle'
  ? [
    '(min-width: 75rem) 600px, (min-width: 48rem) 48vw, 92vw',
    '(min-width: 75rem) 190px, (min-width: 48rem) 15vw, 29vw',
  ]
  : [
    '(min-width: 75rem) 740px, (min-width: 42rem) 60vw, 92vw',
    '(min-width: 75rem) 450px, (min-width: 42rem) 37vw, 92vw',
  ];
const photos = await Promise.all(sourcePhotos.map(async (photo) => ({
  ...photo,
  large: await getImage({
    src: photo.src,
    widths: [640, 1000, 1400],
    width: Math.min(photo.src.width, 1400),
    format: 'webp',
    quality: 84,
  }),
})));
---

<div class:list={['photo-gallery', `photo-gallery--${layout}`]} data-photo-gallery>
  <ul class="gallery-grid">
    {photos.map(({ src, alt, caption, large }, i) => (
      <li>
        <a href={large.src} data-gallery-photo data-srcset={large.srcSet.attribute} data-alt={alt} data-caption={caption} aria-label={`Увеличить фото — ${caption}`}>
          <Image {src} {alt} width={800} widths={[200, 360, 560, 800, 1120]} sizes={imageSizes[i === 0 ? 0 : 1]} format="webp" quality={77} />
          <span class="photo-caption">{caption}</span>
          <span class="expand"><Icon name="expand" size={18} /></span>
        </a>
      </li>
    ))}
  </ul>

  <dialog aria-labelledby={`${group}-viewer-title`}>
    <div class="viewer">
      <h2 id={`${group}-viewer-title`} class="sr-only">Просмотр фотографий</h2>
      <form method="dialog" class="viewer-close">
        <button type="submit" autofocus aria-label="Закрыть просмотр"><Icon name="close" size={25} /></button>
      </form>
      <figure>
        <img alt="" data-viewer-image />
        <figcaption aria-live="polite" data-viewer-caption></figcaption>
      </figure>
      {photos.length > 1 && (
        <div class="viewer-nav">
          <button type="button" aria-label="Предыдущая фотография" data-viewer-prev><Icon name="left" size={24} /></button>
          <button type="button" aria-label="Следующая фотография" data-viewer-next><Icon name="right" size={24} /></button>
        </div>
      )}
    </div>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-photo-gallery]').forEach((gallery) => {
    const dialog = gallery.querySelector<HTMLDialogElement>('dialog');
    const photo = dialog?.querySelector<HTMLImageElement>('[data-viewer-image]');
    const caption = dialog?.querySelector<HTMLElement>('[data-viewer-caption]');
    const links = Array.from(gallery.querySelectorAll<HTMLAnchorElement>('[data-gallery-photo]'));

    if (dialog && photo && caption && links.length) {
      let current = 0;
      let opener: HTMLAnchorElement;
      let touchStart: Touch | undefined;

      const show = (index: number) => {
        current = (index + links.length) % links.length;
        const link = links[current];
        photo.alt = link.dataset.alt ?? '';
        photo.sizes = '(min-width: 84rem) 1280px, 92vw';
        photo.srcset = link.dataset.srcset ?? '';
        photo.src = link.href;
        caption.textContent = `${link.dataset.caption} · ${current + 1} / ${links.length}`;
      };

      links.forEach((link, index) => {
        link.addEventListener('click', (event) => {
          if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          opener = link;
          show(index);
          dialog.showModal();
        });
      });

      dialog.querySelector('[data-viewer-prev]')?.addEventListener('click', () => show(current - 1));
      dialog.querySelector('[data-viewer-next]')?.addEventListener('click', () => show(current + 1));
      dialog.addEventListener('close', () => opener?.focus({ preventScroll: true }));
      dialog.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
          event.preventDefault();
          show(current + (event.key === 'ArrowLeft' ? -1 : 1));
        }
      });

      photo.addEventListener('touchstart', (event) => {
        touchStart = event.touches.length === 1 ? event.touches[0] : undefined;
      }, { passive: true });

      photo.addEventListener('touchcancel', () => { touchStart = undefined; });
      photo.addEventListener('touchend', (event) => {
        const start = touchStart;
        const end = event.changedTouches[0];
        touchStart = undefined;
        if (!start || !end || event.touches.length) return;
        const distance = end.clientX - start.clientX;
        if (Math.abs(distance) > 44 && Math.abs(distance) > Math.abs(end.clientY - start.clientY)) {
          show(current + (distance < 0 ? 1 : -1));
        }
      }, { passive: true });
    }
  });
</script>

<style>
  .gallery-grid {
    display: grid;
    gap: .8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery-grid a {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius);
    background: var(--forest);
    color: white;
  }

  .gallery-grid a:focus-visible {
    outline-color: var(--ink);
  }

  .gallery-grid a::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 55%;
    background: linear-gradient(transparent, #182019d9);
  }

  .gallery-grid :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform .4s ease;
  }

  .gallery-grid a:hover :global(img) {
    transform: scale(1.045);
  }

  .photo-caption, .expand {
    position: absolute;
    z-index: 1;
    bottom: .85rem;
  }

  .photo-caption {
    left: 1rem;
    font-size: .9rem;
    font-weight: 650;
  }

  .expand {
    right: .85rem;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: #19221bdb;
  }

  dialog {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #161d18;
    color: #fff8ef;
  }

  .viewer {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 100%;
    padding: max(3.75rem, calc(env(safe-area-inset-top, 0px) + 3.25rem)) var(--gutter) max(4.25rem, calc(env(safe-area-inset-bottom, 0px) + 4.25rem));
  }

  .viewer figure {
    min-width: 0;
    text-align: center;
  }

  .viewer img {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(74dvh, max(5rem, calc(100dvh - 11rem)));
    margin-inline: auto;
    object-fit: contain;
    touch-action: pinch-zoom;
  }

  figcaption {
    margin-top: .7rem;
    font-size: .875rem;
  }

  .viewer-close {
    position: absolute;
    top: max(.65rem, env(safe-area-inset-top, 0px));
    right: var(--gutter);
  }

  .viewer button {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: 1px solid #f9f3e38a;
    border-radius: 50%;
    background: #252f27;
  }

  .viewer button:hover {
    background: #435246;
  }

  .viewer-nav {
    position: absolute;
    inset: auto 0 max(.75rem, env(safe-area-inset-bottom, 0px));
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  @media (min-width: 42rem) {
    .photo-gallery--travel .gallery-grid:has(li:nth-child(3)) {
      grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr);
      grid-template-rows: repeat(2, minmax(0, 1fr));
    }

    .photo-gallery--travel .gallery-grid:has(li:nth-child(3)) li:first-child {
      grid-row: span 2;
    }

    .gallery-grid li {
      min-height: 0;
    }

    .gallery-grid :global(img) {
      max-height: 32rem;
    }

    .photo-gallery--travel .gallery-grid:has(li:nth-child(3)) li:not(:first-child) :global(img) {
      max-height: 15.6rem;
    }

  }

  .photo-gallery--vehicle .gallery-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: .55rem;
  }

  .photo-gallery--vehicle li:first-child {
    grid-column: 1 / -1;
  }

  .photo-gallery--vehicle li:first-child :global(img) {
    aspect-ratio: 4 / 3;
    max-height: 29rem;
  }

  .photo-gallery--vehicle li:not(:first-child) :global(img) {
    aspect-ratio: 4 / 3;
    max-height: none;
  }

  .photo-gallery--vehicle li:not(:first-child) .photo-caption {
    display: none;
  }

  .photo-gallery--vehicle li:not(:first-child) .expand {
    bottom: .4rem;
    right: .4rem;
    width: 1.8rem;
    height: 1.8rem;
  }
</style>
