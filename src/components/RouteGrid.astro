---
import type { CollectionEntry } from 'astro:content';
import RouteCard from './RouteCard.astro';
import Carousel from './Carousel.astro';

interface Props {
  routes: CollectionEntry<'routes'>[];
  heading?: 'h2' | 'h3';
  prioritizeFirst?: boolean;
  carousel?: boolean;
}

const { routes, heading = 'h3', prioritizeFirst = false, carousel = false } = Astro.props;
---
{carousel ? (
  <Carousel label="Популярные направления">
    {routes.map((route, index) => <RouteCard {route} {heading} priority={prioritizeFirst && index === 0} />)}
  </Carousel>
) : (
  <ul class="route-grid">
    {routes.map((route, index) => <RouteCard {route} {heading} priority={prioritizeFirst && index === 0} />)}
  </ul>
)}
<style>
  .route-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 32rem) { .route-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 66rem) { .route-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
