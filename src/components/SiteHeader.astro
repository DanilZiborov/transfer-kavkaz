---
import Brand from './Brand.astro';
import ContactChannels from './ContactChannels.astro';
import Icon from './Icon.astro';
import { navigation } from '../data/site';
import { localUrl } from '../lib/urls';

const onRoutes = Astro.url.pathname.startsWith(localUrl('routes/'));
---

<header class="site-header">
  <div class="wide header-row">
    <Brand />
    <nav class="desktop-nav" aria-label="Основная навигация">
      {navigation.map(({ label, path }) => (
        <a href={localUrl(path)} aria-current={path === 'routes/' && onRoutes ? (Astro.url.pathname === localUrl(path) ? 'page' : 'location') : undefined}>{label}</a>
      ))}
    </nav>
    <div class="header-contact">
      <ContactChannels variant="header" />
    </div>
    <button class="mobile-toggle icon-button" type="button" popovertarget="mobile-nav" aria-label="Меню навигации">
      <Icon name="menu" size={24} />
    </button>
    <nav id="mobile-nav" class="mobile-nav" popover="auto" aria-label="Основная навигация">
      {navigation.map(({ label, path }) => (
        <a href={localUrl(path)} aria-current={path === 'routes/' && onRoutes ? (Astro.url.pathname === localUrl(path) ? 'page' : 'location') : undefined}>
          {label}<Icon name="arrow" size={18} />
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const mobileNav = document.querySelector<HTMLElement>('#mobile-nav');
  mobileNav?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a, button')) mobileNav.hidePopover();
  });
  matchMedia('(min-width: 52rem)').addEventListener('change', (event) => {
    if (event.matches) mobileNav?.hidePopover();
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 5;
    top: 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }

  .header-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: .2rem .8rem;
    padding-block: .5rem;
    min-height: var(--header-height);
  }

  .desktop-nav {
    display: none;
  }

  .header-contact {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .8rem;
    grid-column: 1 / -1;
    grid-row: 2;
    min-width: 0;
  }

  .header-contact :global(.channels--header) {
    width: 100%;
    justify-content: end;
    gap: .35rem;
  }

  .header-contact :global(.channels--header li:first-child) {
    margin-right: auto;
  }

  .header-contact :global(.phone-number) {
    font-size: clamp(1rem, 3.5vw, 1.2rem);
    padding-inline: 0;
  }

  .header-contact :global(.phone-number svg) {
    display: none;
  }

  .header-contact :global(.contact-link--icon) {
    background: var(--sand);
  }

  .mobile-toggle {
    grid-column: 2;
    grid-row: 1;
  }

  .mobile-nav {
    position: fixed;
    inset: calc(var(--header-height) + .5rem) var(--gutter) auto;
    width: auto;
    max-height: calc(100dvh - var(--header-height) - var(--bottom-bar) - 1rem);
    margin: 0;
    padding: .4rem .85rem .85rem;
    border: 1px solid var(--line);
    border-radius: .8rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .mobile-nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    padding: .4rem .5rem;
    text-decoration: none;
    font-size: 1.05rem;
  }

  .mobile-nav a + a {
    border-top: 1px solid var(--line);
  }


  nav a:hover, nav a[aria-current] {
    color: var(--rust);
  }

  @media (min-width: 52rem) {
    .header-row {
      grid-template-columns: auto minmax(0, 1fr);
      gap: .2rem 1rem;
    }

    .header-contact {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .header-contact :global(.channels--header) {
      width: auto;
      gap: .4rem;
    }


    .desktop-nav {
      display: flex;
      grid-row: 2;
      grid-column: 1 / -1;
      justify-content: center;
      gap: 2rem;
      font-size: 1rem;
      font-weight: 650;
    }

    .desktop-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
      text-decoration: none;
    }

    .mobile-toggle, .mobile-nav {
      display: none;
    }

  }

  @media (min-width: 80rem) {
    .header-row {
      grid-template-columns: auto 1fr auto;
      gap: 1.6rem;
    }

    .desktop-nav {
      grid-column: 2;
      grid-row: 1;
      gap: clamp(1rem, 1.5vw, 1.75rem);
    }

    .header-contact {
      grid-column: 3;
      gap: .75rem;
    }

  }
</style>
