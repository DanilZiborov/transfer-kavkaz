---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactButton from '../components/ContactButton.astro';
import ContactLink from '../components/ContactLink.astro';
import Gallery from '../components/Gallery.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import RouteGrid from '../components/RouteGrid.astro';
import Carousel from '../components/Carousel.astro';
import { heroPhoto, vehicleGallery } from '../data/photography';
import { reviews } from '../data/reviews';
import { site } from '../data/site';
import { getRoutes } from '../lib/routes';
import { localUrl } from '../lib/urls';

const title = 'Индивидуальные трансферы по Северному Кавказу | Transfer Kavkaz';
const description = 'Индивидуальные поездки из Минеральных Вод и других городов КМВ в Архыз, Домбай, Приэльбрусье и по Северному Кавказу.';
const featured = (await getRoutes()).filter(({ data }) => data.featured).slice(0, 8);
---

<BaseLayout title={title} description={description}>
  <section class="hero wide" aria-labelledby="hero-title">
    <Image {...heroPhoto} class="hero-photo" widths={[720, 960, 1280, 1600, 1774]} sizes="(min-width: 95rem) 1408px, 92vw" format="webp" quality={80} priority />
    <div class="hero-content">
      <p class="eyebrow"><Icon name="pin" size={16} /> Северный Кавказ</p>
      <h1 id="hero-title">Трансферы<br />по Кавказу</h1>
      <p class="hero-lead">Индивидуальные поездки из Минеральных Вод и других городов КМВ.</p>
      <ContactButton label="Забронировать поездку" variant="accent" />
    </div>
  </section>

  <section id="about" class="section container about" aria-labelledby="about-title">
    <div>
      <p class="eyebrow">О нас</p>
      <h2 id="about-title">Поездки по вашему маршруту</h2>
    </div>
    <div class="about-copy">
      <p class="lead">Встречаем в аэропорту, на вокзале или по вашему адресу и везём к месту назначения. Автомобиль целиком в вашем распоряжении.</p>
      <p>Базируемся в Минеральных Водах. Подаём машину в любом городе КМВ. Другие места подачи, остановки и обратную поездку согласуем заранее.</p>
    </div>
    <div class="cities">
      <p><Icon name="pin" size={19} /> Города подачи</p>
      <ul>{site.departureCities.map((city) => <li>{city}</li>)}</ul>
    </div>
  </section>

  <section id="vehicle" class="section vehicle" aria-labelledby="vehicle-title">
    <div class="container vehicle-layout" data-reveal>
      <PhotoGallery photos={vehicleGallery} group="vehicle" layout="vehicle" />
      <div class="vehicle-copy">
        <p class="eyebrow">Автомобиль</p>
        <h2 id="vehicle-title">{site.vehicle.model}</h2>
        <p class="lead">Серебристый минивэн {site.vehicle.year} года для поездок с семьёй, друзьями или своей компанией.</p>
        <p>Весь автомобиль предоставляется для вашей поездки. На нём можно встретить вас в аэропорту или на вокзале, отвезти к гостинице и согласовать обратный трансфер.</p>
        <p>Перед поездкой сообщите количество пассажиров и объём багажа. Если везёте детскую коляску, лыжи или другое крупное снаряжение, обсудите размещение заранее.</p>
        <p>Место встречи, остановки по пути и время обратной подачи согласовываются с водителем.</p>
        <ContactButton label="Забронировать поездку" />
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="routes-title" data-reveal>
    <div class="section-heading">
      <div>
        <p class="eyebrow">Направления</p>
        <h2 id="routes-title">Популярные направления</h2>
      </div>
      <a class="text-link" href={localUrl('routes/')}>Все направления <Icon name="arrow" size={18} /></a>
    </div>
    <RouteGrid routes={featured} carousel />
  </section>

  <section class="section container" aria-labelledby="reviews-title" data-reveal>
    <div class="section-heading">
      <h2 id="reviews-title">Отзывы</h2>
    </div>
    <div class="reviews"><Carousel label="Отзывы" variant="reviews">
      {reviews.map((review) => (
        <li>
          <figure>
            {review.rating && <p class="stars" aria-label={`Оценка ${review.rating} из 5`}>{'★'.repeat(review.rating)}</p>}
            <blockquote><p>«{review.text}»</p></blockquote>
            <figcaption>
              <strong>{review.author}</strong>
              {review.url ? <a href={review.url}>{review.source}</a> : <span>{review.source}</span>}
            </figcaption>
          </figure>
        </li>
      ))}
    </Carousel></div>
  </section>

  <div class="gallery-wrap"><Gallery /></div>

  <section id="contacts" class="contacts" aria-labelledby="contacts-title">
    <div class="section container contact-layout" data-reveal>
      <div>
        <p class="eyebrow">Контакты</p>
        <h2 id="contacts-title">Закажите трансфер<br />по вашему маршруту</h2>
        <p>Свяжитесь с водителем напрямую — согласуем подачу, направление и стоимость.</p>
      </div>
      <div class="contact-copy">
        <ContactLink channel="phone" showNumber prominent />
        <div class="contact-messengers">
          <ContactLink channel="whatsapp" />
          <ContactLink channel="max" />
        </div>
        <p>Для расчёта стоимости назовите дату, место подачи и пункт назначения.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('revealed');
        observer.unobserve(entry.target);
      }
    });

    document.querySelectorAll('[data-reveal]').forEach((section) => observer.observe(section));
  }
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-start;
    min-height: clamp(29rem, 47vw, 37rem);
    margin-top: clamp(.75rem, 2vw, 1.6rem);
    overflow: hidden;
    border-radius: 1rem;
    background: var(--forest);
    color: #fff8ee;
  }

  .hero-photo, .hero::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-photo { object-fit: cover; object-position: 83% 59%; }
  .hero::after {
    content: "";
    background: linear-gradient(180deg, #142019e8, #142019aa 44%, #14201908 75%);
  }

  .hero-content {
    width: 100%;
    max-width: 54rem;
    padding: clamp(1.25rem, 5vw, 5.25rem);
    padding-top: clamp(1.65rem, 5vw, 5.25rem);
  }

  .hero h1 { text-wrap: initial; }
  .hero .eyebrow { color: #ffe1bf; }
  .hero-lead { max-width: 26rem; margin: 1.15rem 0 1.35rem; font-size: clamp(1rem, 2vw, 1.22rem); line-height: 1.55; }

  .about, .vehicle-layout, .contact-layout { display: grid; gap: 1.25rem; }
  .about h2, .contacts h2 { text-wrap: pretty; }
  .about-copy, .vehicle-copy, .contact-copy { display: grid; align-content: start; gap: .9rem; }
  .about-copy > p, .vehicle-copy > p:not(.eyebrow) { max-width: 39rem; color: var(--muted); }
  .vehicle-copy .eyebrow + h2 { margin-top: 0; }
  .vehicle-copy .button { margin-top: .25rem; }

  .cities {
    padding-top: 1.15rem;
    border-top: 1px solid var(--line);
  }

  .cities p, .cities ul { display: flex; align-items: center; gap: .45rem; }
  .cities p { color: var(--rust); font-size: 1rem; font-weight: 700; }
  .cities ul {
    flex-wrap: wrap;
    gap: .65rem;
    margin: .9rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
  }
  .cities li { padding: .35rem .75rem; border: 1px solid var(--line); border-radius: 2rem; font-weight: 500; font-size: .9rem; }

  .vehicle, .gallery-wrap { background: var(--sand); }

  .section-heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: .6rem 1.5rem;
    margin-bottom: clamp(1.35rem, 3vw, 2.25rem);
  }

  .reviews {
    display: grid;
    gap: .85rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .reviews figure {
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: .85rem;
    height: 100%;
    padding: clamp(1rem, 3vw, 1.65rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fffdf8;
  }

  .stars { color: var(--rust); letter-spacing: .13em; }
  .reviews figcaption {
    display: grid;
    gap: .12rem;
    padding-top: .9rem;
    border-top: 1px solid var(--line);
  }
  .reviews figcaption :is(a, span) { color: var(--muted); font-size: .8rem; }

  .contacts { background: var(--forest); color: var(--paper); }
  .contacts h2 { margin-bottom: 1rem; }
  .contact-layout > div > p:not(.eyebrow) { max-width: 31rem; color: #e0e1d5; }
  .contacts .eyebrow { color: var(--accent); }
  .contact-copy > p { max-width: 29rem; color: #e0e1d5; }
  .contact-copy :global(.phone-number) { justify-content: center; gap: .9rem; padding: .9rem 1.4rem; text-align: center; }
  .contact-copy :global(.phone-number svg) { width: 1.8rem; height: 1.8rem; }
  .contact-copy :global(.contact-link--prominent) { width: fit-content; max-width: 100%; min-height: 4.5rem; background: var(--accent); color: var(--ink); border-radius: 5rem; }
  .contact-copy :global(.contact-link--prominent:hover) { background: #ffdbb6; color: var(--ink); }
  .contact-messengers { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: min(100%, 22rem); gap: .65rem; margin-top: .6rem; }
  .contact-messengers :global(.contact-link) { min-height: 3.2rem; padding-inline: 1.15rem; border: 1px solid #f9f5e880; }
  .contact-copy :global(.contact-link:not(.contact-link--prominent):hover) { color: var(--accent); }

  .revealed { animation: reveal .4s ease-out; }
  @keyframes reveal {
    from { opacity: .82; transform: translateY(.5rem); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 42rem) {
    .hero { align-items: center; }
    .hero-photo { object-position: center 61%; }
    .hero::after { background: linear-gradient(90deg, #162019de, #1620198c 36%, #16201908 72%); }

  }

  @media (min-width: 48rem) {
    .about, .contact-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.07fr);
      column-gap: clamp(2rem, 6vw, 6rem);
    }
    .about-copy, .contact-copy { align-content: center; }
    .cities { grid-column: 1 / -1; margin-top: 1.5rem; }
    .cities ul { gap: .65rem; }
    .vehicle-layout {
      grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr);
      align-items: center;
      gap: clamp(2rem, 6vw, 6rem);
    }
  }
</style>
